# Copiez ce fichier en « .env » ou exportez ces variables avant « npm start ».
# Toutes sont facultatives : les valeurs ci-dessous sont celles par défaut.

# Réseau : 127.0.0.1 = accès depuis ce PC uniquement ; 0.0.0.0 = accessible sur le réseau local.
HOST=127.0.0.1
PORT=8484

# Données de l'application (base SQLite, caches) et dossier des téléchargements.
DATA_DIR=data
# MEDIA_DIR=/chemin/vers/ma/videotheque

# Source (modifiable ensuite dans Paramètres).
SOURCE_BASE_URL=https://a.111477.xyz
SOURCE_MOVIES_PATH=/movies/
SOURCE_SERIES_PATH=/tvs/

# Métadonnées TMDB (catalogue avec l'extension, affiches, résumés) : clé API v3 ou jeton v4.
# TMDB_API_KEY=

# Binaires ffmpeg (si non présents dans le PATH).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Extension Stremio qui fournit les liens des fichiers (lien d'installation ou manifeste).
# Vide : la liste de la source est lue directement. Aussi réglable dans Paramètres.
STREMIO_ADDON_URL=https://st.111477.xyz/manifest.json

# Journalisation : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
