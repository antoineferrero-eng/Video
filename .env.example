# Copiez ce fichier en « .env » ou exportez ces variables avant « npm start ».
# Toutes sont facultatives : les valeurs ci-dessous sont celles par défaut.

# Réseau : 127.0.0.1 = accès depuis ce PC uniquement ; 0.0.0.0 = accessible sur le réseau local.
HOST=127.0.0.1
PORT=8484

# Données de l'application (base SQLite, caches) et dossier des téléchargements.
DATA_DIR=data
# MEDIA_DIR=/chemin/vers/ma/videotheque

# TMDB (catalogue, affiches, résumés) : clé API v3 ou jeton v4. Indispensable : le catalogue
# des films et séries vient de TMDB. Aussi réglable dans Paramètres.
# TMDB_API_KEY=

# Binaires ffmpeg (si non présents dans le PATH).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Extensions Stremio qui fournissent les liens des fichiers (liens d'installation ou manifestes),
# par ordre de préférence et séparées par des virgules. Aussi réglables dans Paramètres.
STREMIO_ADDON_URLS=https://st.111477.xyz/manifest.json

# Sous-titres en ligne : extensions Stremio de sous-titres (adresses séparées par des virgules,
# vide : aucune) et clé d'API OpenSubtitles.com (facultative). Aussi réglables dans Paramètres.
SUBTITLE_ADDON_URLS=https://opensubtitles-v3.strem.io/manifest.json
# OPENSUBTITLES_API_KEY=

# Journalisation : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
